*.log
npm-debug.log*
yarn-debug.log*

# Env files — never commit secrets
.env
.env.local
.env.*.local

# Build artifacts (also covered by web/.gitignore but listed for safety)
node_modules/
.next/
out/
build/
*.tsbuildinfo

# Vercel
.vercel

